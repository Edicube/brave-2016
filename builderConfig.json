{
  "osx": {
    "title": "Brave 2016",
    "background": "res/background.png",
    "icon": "res/brave_installer.icns",
    "icon-size": 80,
    "contents": [
      { "x": 438, "y": 344, "type": "link", "path": "/Applications" },
      { "x": 192, "y": 344, "type": "file" }
    ],
    "_signing_intent": {
      "comment": "Fill these in when a Developer ID certificate is available. electron-osx-sign reads CSC_NAME from the environment; tools/sign-darwin.sh already wires the identity through.",
      "tool": "electron-osx-sign",
      "identity_env": "CSC_NAME",
      "hardened_runtime": true,
      "entitlements": "res/entitlements.plist"
    }
  },
  "win32": {
    "title": "Brave 2016",
    "version": "0.0.3",
    "iconUrl": "res/app.ico",
    "setup_icon": "res/app.ico",
    "nsiTemplate": "res/installer.nsi.tpl",
    "_signing_intent": {
      "comment": "Fill in when an Authenticode certificate is available. signtool runs against the packaged exe produced by tools/package.js.",
      "tool": "signtool",
      "certificate_path_env": "CSC_LINK",
      "certificate_password_env": "CSC_KEY_PASSWORD",
      "timestamp_server": "http://timestamp.digicert.com"
    }
  }
}
